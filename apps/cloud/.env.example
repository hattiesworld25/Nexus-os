# Browser-safe values from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact origin. Local default shown; use deployed HTTPS origin in Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SERVER ONLY. Prefer a Supabase secret key; legacy service-role also works.
SUPABASE_SECRET_KEY=
# Optional AI assistant. Leave both empty to disable AI only.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_LIMIT=20
